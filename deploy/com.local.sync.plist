<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.sync</string>
  <!-- launchd does not expand ~ or $HOME in ProgramArguments, so run through a shell.
       Adjust the path if the repo is not cloned into ~/algo/local-sync. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/algo/local-sync/bin/local-sync" run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/local-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/local-sync.err</string>
</dict>
</plist>
